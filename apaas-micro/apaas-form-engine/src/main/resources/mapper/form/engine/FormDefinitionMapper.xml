<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.apaas.form.engine.mapper.FormDefinitionMapper">

    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="org.apaas.form.engine.entity.FormDefinition">
        <id column="id" property="id"/>
        <result column="name" property="name"/>
        <result column="code" property="code"/>
        <result column="type" property="type"/>
        <result column="status" property="status"/>
        <result column="config_json" property="configJson"/>
        <result column="items_json" property="itemsJson"/>
        <result column="data_source_id" property="dataSourceId"/>
        <result column="flow_id" property="flowId"/>
        <result column="version" property="version"/>
        <result column="is_default" property="isDefault"/>
        <result column="tenant_id" property="tenantId"/>
        <result column="create_by" property="createBy"/>
        <result column="create_time" property="createTime"/>
        <result column="update_by" property="updateBy"/>
        <result column="update_time" property="updateTime"/>
        <result column="deleted" property="deleted"/>
    </resultMap>

    <!-- 分页查询表单定义 -->
    <select id="selectPage" resultMap="BaseResultMap">
        SELECT * FROM form_definition
        WHERE deleted = 0
        <if test="query.name != null">AND name LIKE CONCAT('%', #{query.name}, '%')</if>
        <if test="query.type != null">AND type = #{query.type}</if>
        <if test="query.status != null">AND status = #{query.status}</if>
        <if test="query.tenantId != null">AND tenant_id = #{query.tenantId}</if>
        ORDER BY create_time DESC
    </select>

    <!-- 更新表单定义的默认版本状态 -->
    <update id="updateIsDefaultByCode">
        UPDATE form_definition
        SET is_default = #{isDefault},
            update_by = #{updateBy},
            update_time = NOW()
        WHERE code = #{code}
          AND tenant_id = #{tenantId}
          AND deleted = 0
    </update>
</mapper>
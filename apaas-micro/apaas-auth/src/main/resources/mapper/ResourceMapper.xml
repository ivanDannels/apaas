<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.apaas.authorization.mapper.ResourceMapper">

    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="org.apaas.authorization.entity.Resource">
        <id column="id" property="id"/>
        <result column="name" property="name"/>
        <result column="type" property="type"/>
        <result column="path" property="path"/>
        <result column="component" property="component"/>
        <result column="permission" property="permission"/>
        <result column="parent_id" property="parentId"/>
        <result column="sort" property="sort"/>
        <result column="icon" property="icon"/>
        <result column="status" property="status"/>
        <result column="tenant_id" property="tenantId"/>
        <result column="create_by" property="createBy"/>
        <result column="create_time" property="createTime"/>
        <result column="update_by" property="updateBy"/>
        <result column="update_time" property="updateTime"/>
        <result column="deleted" property="deleted"/>
    </resultMap>

    <!-- 分页查询 -->
    <select id="selectPage" resultMap="BaseResultMap">
        SELECT
            r.id,
            r.name,
            r.type,
            r.path,
            r.component,
            r.permission,
            r.parent_id,
            r.sort,
            r.icon,
            r.status,
            r.tenant_id,
            r.create_by,
            r.create_time,
            r.update_by,
            r.update_time,
            r.deleted
        FROM
            sys_resource r
        WHERE
            r.deleted = 0
            AND r.tenant_id = #{tenantId}
        <if test="name != null and name != ''">
            AND r.name LIKE CONCAT('%', #{name}, '%')
        </if>
        <if test="type != null">
            AND r.type = #{type}
        </if>
        <if test="status != null">
            AND r.status = #{status}
        </if>
        <if test="parentId != null">
            AND r.parent_id = #{parentId}
        </if>
        ORDER BY
            r.sort ASC
    </select>

    <!-- 查询所有资源用于构建树形结构 -->
    <select id="selectAll" resultMap="BaseResultMap">
        SELECT
            r.id,
            r.name,
            r.type,
            r.path,
            r.component,
            r.permission,
            r.parent_id,
            r.sort,
            r.icon,
            r.status,
            r.tenant_id,
            r.create_by,
            r.create_time,
            r.update_by,
            r.update_time,
            r.deleted
        FROM
            sys_resource r
        WHERE
            r.deleted = 0
            AND r.tenant_id = #{tenantId}
            AND r.status = 0
        ORDER BY
            r.sort ASC
    </select>

    <!-- 根据角色ID查询资源 -->
    <select id="selectByRoleId" resultMap="BaseResultMap">
        SELECT
            r.id,
            r.name,
            r.type,
            r.path,
            r.component,
            r.permission,
            r.parent_id,
            r.sort,
            r.icon,
            r.status,
            r.tenant_id,
            r.create_by,
            r.create_time,
            r.update_by,
            r.update_time,
            r.deleted
        FROM
            sys_resource r
        INNER JOIN sys_role_resource rr ON r.id = rr.resource_id
        WHERE
            r.deleted = 0
            AND rr.deleted = 0
            AND r.tenant_id = #{tenantId}
            AND rr.role_id = #{roleId}
        ORDER BY
            r.sort ASC
    </select>

</mapper>